<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless, engine-agnostic game core.
    BCL only: do NOT add PackageReferences or any Godot/engine assemblies here.
    Enforced by tests/Crossword.Tests/Architecture/CoreDependencyTests.cs.
  -->
  <PropertyGroup>
    <RootNamespace>Crossword.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ENABLE word list (public domain). -->
    <EmbeddedResource Include="Lexicon\Data\enable1.txt" LogicalName="Crossword.Core.Lexicon.enable1.txt" />
    <!-- Words never accepted from any word list (slurs). -->
    <EmbeddedResource Include="Lexicon\Data\denylist.txt" LogicalName="Crossword.Core.Lexicon.denylist.txt" />
    <!-- Word definitions from Open English WordNet (CC BY 4.0); generated by tools/Crossword.DefinitionsBuilder. -->
    <EmbeddedResource Include="Lexicon\Data\definitions.tsv.gz" LogicalName="Crossword.Core.Lexicon.definitions.tsv.gz" />
    <!-- Dictionary overlays (hand-written), one per Dictionaries entry. -->
    <EmbeddedResource Include="Lexicon\Data\tech-shorthand.tsv" LogicalName="Crossword.Core.Lexicon.tech-shorthand.tsv" />
    <EmbeddedResource Include="Lexicon\Data\atlas.tsv" LogicalName="Crossword.Core.Lexicon.atlas.tsv" />
  </ItemGroup>

</Project>
